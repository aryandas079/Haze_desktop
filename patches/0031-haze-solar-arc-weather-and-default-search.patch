+    if (q.includes('perth')) return 'Australia/Perth';
+    if (q.includes('auckland') || q.includes('wellington') || q.includes('new zealand')) return 'Pacific/Auckland';
+    if (q.includes('tokyo') || q.includes('osaka') || q.includes('kyoto') || q.includes('japan')) return 'Asia/Tokyo';
+    if (q.includes('london') || q.includes('manchester') || q.includes('uk') || q.includes('england')) return 'Europe/London';
+    if (q.includes('paris') || q.includes('france') || q.includes('lyon')) return 'Europe/Paris';
+    if (q.includes('berlin') || q.includes('munich') || q.includes('germany') || q.includes('frankfurt')) return 'Europe/Berlin';
+    if (q.includes('rome') || q.includes('milan') || q.includes('italy')) return 'Europe/Rome';
+    if (q.includes('madrid') || q.includes('barcelona') || q.includes('spain')) return 'Europe/Madrid';
+    if (q.includes('new york') || q.includes('nyc') || q.includes('boston') || q.includes('miami') || q.includes('washington')) return 'America/New_York';
+    if (q.includes('chicago') || q.includes('dallas') || q.includes('houston') || q.includes('austin')) return 'America/Chicago';
+    if (q.includes('denver') || q.includes('phoenix') || q.includes('salt lake')) return 'America/Denver';
+    if (q.includes('san francisco') || q.includes('los angeles') || q.includes('seattle') || q.includes('california')) return 'America/Los_Angeles';
+    if (q.includes('toronto') || q.includes('montreal') || q.includes('ottawa')) return 'America/Toronto';
+    if (q.includes('vancouver')) return 'America/Vancouver';
+    if (q.includes('dubai') || q.includes('uae') || q.includes('abu dhabi')) return 'Asia/Dubai';
+    if (q.includes('singapore')) return 'Asia/Singapore';
+    if (q.includes('hong kong')) return 'Asia/Hong_Kong';
+    if (q.includes('beijing') || q.includes('shanghai') || q.includes('china')) return 'Asia/Shanghai';
+    if (q.includes('seoul') || q.includes('korea')) return 'Asia/Seoul';
+    if (q.includes('bangkok') || q.includes('thailand')) return 'Asia/Bangkok';
+    if (q.includes('cairo') || q.includes('egypt')) return 'Africa/Cairo';
+    if (q.includes('johannesburg') || q.includes('cape town') || q.includes('south africa')) return 'Africa/Johannesburg';
+    if (q.includes('sao paulo') || q.includes('rio') || q.includes('brazil')) return 'America/Sao_Paulo';
+    if (q.includes('mexico')) return 'America/Mexico_City';
+    if (q.includes('india') || q.includes('silchar') || q.includes('assam') || q.includes('delhi') || q.includes('mumbai') || q.includes('kolkata') || q.includes('bangalore') || q.includes('chennai') || q.includes('hyderabad')) return 'Asia/Kolkata';
+    try {
+      Intl.DateTimeFormat(undefined, { timeZone: query });
+      return query;
+    } catch (_e) {}
