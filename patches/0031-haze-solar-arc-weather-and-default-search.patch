+
+function initHazeHomescreen(): void {
+  // 1. Theme handler
+  function updateTheme(): void {
+    try {
+      const isIncognito = document.location.search.includes('incognito') ||
+                          document.body.classList.contains('incognito') ||
+                          document.documentElement.classList.contains('incognito');
+      if (isIncognito) {
+        document.documentElement.classList.add('dark-theme');
+        return;
+      }
+      if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
+        document.documentElement.classList.add('dark-theme');
+        return;
+      }
+    } catch (_e) {}
+    document.documentElement.classList.remove('dark-theme');
+  }
+  updateTheme();
+  if (window.matchMedia) {
+    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', updateTheme);
+  }
+
+  // 2. Exact Weather Flyer & Live Meteorological Engine (from user photo)
+  interface ForecastItem {
+    dayName: string;
+    dayNum: string;
+    conditionText: string;
+    iconType: 'sun' | 'rain' | 'cloud' | 'snow' | 'night';
+    tempMin: number;
+    tempMax: number;
