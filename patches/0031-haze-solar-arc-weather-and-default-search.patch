+}
+.weather-location-pill-btn:active {
+  transform: scale(0.97);
+}
+.weather-flyer-actions {
+  display: flex;
+  align-items: center;
+  gap: 8px;
+}
+.weather-search-toggle-btn {
+  width: 32px;
+  height: 32px;
+  border-radius: 50%;
+  background: rgba(255, 255, 255, 0.85);
+  backdrop-filter: blur(8px);
+  border: none;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  color: #374151;
+  cursor: pointer;
+  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
