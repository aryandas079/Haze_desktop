+  font-weight: 300;
+  letter-spacing: -1.5px;
+  line-height: 1;
+  color: #1F2937;
+  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
+}
+.flyer-refresh-btn {
+  width: 26px;
+  height: 26px;
+  border-radius: 50%;
+  background: #00A3FF;
+  border: none;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  color: #FFFFFF;
+  cursor: pointer;
+  box-shadow: 0 2px 6px rgba(0, 163, 255, 0.35);
