+}
+.flyer-row-day-num {
+  font-size: 12px;
+  font-weight: 800;
+  color: #111827;
+}
+
+/* Customization Flyout Menu */
+.haze-menu-flyout {
+  position: fixed;
+  top: 68px;
+  right: 28px;
