+  border: none;
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  color: #374151;
+  cursor: pointer;
+  transition: all 0.2s ease;
+}
+.weather-flyer-close-btn:hover {
+  background: #FFFFFF;
+  transform: scale(1.08);
+}
+
+/* Location Title Over Artwork */
+.weather-flyer-loc-block {
+  margin-top: 18px;
+  position: relative;
+  z-index: 5;
