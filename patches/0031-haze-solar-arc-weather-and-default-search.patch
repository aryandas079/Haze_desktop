+  function applyFallbackCityWeather(query: string): void {
+    const trimmed = query.trim();
+    const key = trimmed.toLowerCase();
+    const preset = (key === 'auto' || key === 'your location') ? CITY_PRESETS['silchar'] : (CITY_PRESETS[key] || null);
+    const timezone = preset ? preset.timezone : resolveCityTimezone(trimmed);
+
+    const now = getCityDate(timezone);
+    const hour = now.getHours();
+    const days = ['SUN', 'MON', 'TUE', 'WED', 'THU', 'FRI', 'SAT'];
+
+    let city = trimmed;
+    let country = 'Global';
+    let baseTemp = 20;
+    let condition = 'Pleasant';
+    let theme: 'rain' | 'sunny' | 'cloudy' | 'night' = 'sunny';
+    let iconType: 'sun' | 'rain' | 'cloud' | 'night' = 'sun';
+    const customForecast = preset?.customForecast;
+
+    if (preset) {
+      city = preset.city;
+      country = preset.country;
+      baseTemp = preset.baseTemp;
+      condition = preset.conditionTitle;
+      theme = preset.theme;
+      iconType = preset.iconType;
+    } else {
+      city = trimmed.split(' ').map(w => w.charAt(0).toUpperCase() + w.slice(1).toLowerCase()).join(' ');
+      if (key.includes('london') || key.includes('uk') || key.includes('england')) {
+        country = 'United Kingdom';
+        baseTemp = 19;
+        theme = 'rain';
+        iconType = 'rain';
+        condition = 'Heavy Rain';
+      } else if (key.includes('india') || key.includes('silchar') || key.includes('assam')) {
+        country = 'India';
+        baseTemp = 27;
+        theme = 'sunny';
+        iconType = 'sun';
+        condition = 'Sunny';
+      } else {
+        let hash = 0;
+        for (let i = 0; i < trimmed.length; i++) {
+          hash = (hash * 31 + trimmed.charCodeAt(i)) & 0x7fffffff;
+        }
+        baseTemp = 18 + (hash % 11);
+        const conds = ['Sunny', 'Partly Cloudy', 'Clear Sky', 'Mild & Pleasant', 'Breezy', 'Passing Clouds'];
+        condition = conds[hash % conds.length] || 'Pleasant';
+        if (condition.includes('Cloud')) {
+          theme = 'cloudy';
+          iconType = 'cloud';
+        } else {
+          theme = 'sunny';
+          iconType = 'sun';
+        }
+      }
+    }
