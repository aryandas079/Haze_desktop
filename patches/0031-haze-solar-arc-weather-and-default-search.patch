+class HazeWeatherMessageHandler : public content::WebUIMessageHandler {
+ public:
+  explicit HazeWeatherMessageHandler(Profile* profile) : profile_(profile) {}
+  ~HazeWeatherMessageHandler() override = default;
+
+  void RegisterMessages() override {
+    web_ui()->RegisterMessageCallback(
+        "getHazeWeather",
+        base::BindRepeating(&HazeWeatherMessageHandler::HandleGetWeather,
+                            base::Unretained(this)));
+  }
+
+ private:
+  void HandleGetWeather(const base::ListValue& args) {
+    AllowJavascript();
+    if (args.empty()) {
+      return;
+    }
+    const base::Value& callback_id = args[0];
+    std::string query;
+    if (args.size() > 1 && args[1].is_string()) {
+      query = args[1].GetString();
+    }
+
+    std::string path =
+        query.empty() ? "" : base::EscapeQueryParamValue(query, false);
+    GURL weather_url("https://wttr.in/" + path + "?format=j1");
+
+    net::NetworkTrafficAnnotationTag traffic_annotation =
+        net::DefineNetworkTrafficAnnotation("haze_weather_fetcher", R"(
+          semantics {
+            sender: "Haze Live Weather Widget"
+            description: "Fetches current live weather and forecast for user location."
+            trigger: "User opens New Tab Page or searches weather location."
+            data: "Location query string (city name)."
+            destination: OTHER
+          }
+          policy {
+            cookies_allowed: NO
+            setting: "This feature cannot be disabled by settings."
+            policy_exception_justification: "Not implemented."
+          })");
+
+    auto resource_request = std::make_unique<network::ResourceRequest>();
+    resource_request->url = weather_url;
+    resource_request->credentials_mode = network::mojom::CredentialsMode::kOmit;
+    resource_request->headers.SetHeader(net::HttpRequestHeaders::kUserAgent, "curl/8.0");
+
+    auto loader = network::SimpleURLLoader::Create(std::move(resource_request),
+                                                   traffic_annotation);
+    loader->SetTimeoutDuration(base::Seconds(6));
+
+    auto* raw_loader = loader.get();
+    raw_loader->DownloadToString(
+        profile_->GetURLLoaderFactory().get(),
+        base::BindOnce(&HazeWeatherMessageHandler::OnWeatherLoaded,
+                       weak_ptr_factory_.GetWeakPtr(), std::move(loader),
+                       callback_id.Clone()),
+        512 * 1024);
+  }
+
+  void OnWeatherLoaded(std::unique_ptr<network::SimpleURLLoader> loader,
+                       base::Value callback_id,
+                       std::optional<std::string> body) {
+    if (body && !body->empty() && body->front() == '{') {
+      ResolveJavascriptCallback(callback_id, base::Value(*body));
+    } else {
+      RejectJavascriptCallback(callback_id, base::Value("Failed to load weather"));
+    }
+  }
+
+  raw_ptr<Profile> profile_;
+  base::WeakPtrFactory<HazeWeatherMessageHandler> weak_ptr_factory_{this};
+};
+
 }  // namespace
 
