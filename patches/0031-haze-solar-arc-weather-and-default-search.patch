+    }
+    if (weatherFlyoutCityDesc) {
+      weatherFlyoutCityDesc.textContent = `Current: ${activeWeather.city}`;
+    }
+    const curHour = now.getHours();
+    const curMin = now.getMinutes();
+    const curSec = now.getSeconds();
+    const currentDecimalHour = curHour + curMin / 60 + curSec / 3600;
+
+    let isDay = currentDecimalHour >= 6.0 && currentDecimalHour < 18.0;
+    let progress = 0.5;
+    let timeTitle = '';
+
+    if (activeWeather.sunrise && activeWeather.sunset) {
+      const parseTimeMin = (timeStr: string): number => {
+        const match = timeStr.match(/(\d+):(\d+)\s*(AM|PM)/i);
+        if (!match) return 360;
+        let h = parseInt(match[1] || '0', 10);
+        const m = parseInt(match[2] || '0', 10);
+        const isPM = (match[3] || '').toUpperCase() === 'PM';
+        if (isPM && h < 12) h += 12;
+        if (!isPM && h === 12) h = 0;
+        return h * 60 + m;
+      };
+      const riseMin = parseTimeMin(activeWeather.sunrise);
+      const setMin = parseTimeMin(activeWeather.sunset);
+      const curMinTotal = curHour * 60 + curMin;
+      isDay = (curMinTotal >= riseMin && curMinTotal < setMin);
+
+      if (isDay) {
+        const dayDuration = Math.max(1, setMin - riseMin);
+        progress = Math.max(0.04, Math.min(0.96, (curMinTotal - riseMin) / dayDuration));
+        const leftMin = setMin - curMinTotal;
+        timeTitle = `${Math.floor(leftMin / 60)}h ${leftMin % 60}m left until sunset (Sunset at ${activeWeather.sunset})`;
+      } else {
+        const nightDuration = Math.max(1, (1440 - setMin) + riseMin);
+        const nightElapsed = curMinTotal >= setMin ? (curMinTotal - setMin) : (1440 - setMin + curMinTotal);
+        progress = Math.max(0.04, Math.min(0.96, nightElapsed / nightDuration));
+        const leftMin = curMinTotal < riseMin ? (riseMin - curMinTotal) : (1440 - curMinTotal + riseMin);
