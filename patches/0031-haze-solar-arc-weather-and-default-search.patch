+  // Helper to calculate point along solar arc cubic Bezier (P0=(12,26), P1=(52,6), P2=(144,6), P3=(184,26))
+  function getSolarArcPoint(t: number): { x: number; y: number } {
+    const clampedT = Math.max(0.04, Math.min(0.96, t));
+    const u = 1 - clampedT;
+    const tt = clampedT * clampedT;
+    const uu = u * u;
+    const uuu = uu * u;
+    const ttt = tt * clampedT;
+    const x = uuu * 12 + 3 * uu * clampedT * 52 + 3 * u * tt * 144 + ttt * 184;
+    const y = uuu * 26 + 3 * uu * clampedT * 6 + 3 * u * tt * 6 + ttt * 26;
+    return { x: Math.round(x * 10) / 10, y: Math.round(y * 10) / 10 };
+  }
