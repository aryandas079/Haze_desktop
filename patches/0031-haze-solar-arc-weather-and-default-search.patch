+  padding: 20px 22px 16px 22px;
+  box-shadow: 0 -4px 18px rgba(0, 0, 0, 0.04);
+  display: flex;
+  flex-direction: column;
+}
+
+/* Status & Date Row */
+.flyer-status-row {
+  display: flex;
+  align-items: flex-start;
+  justify-content: space-between;
+}
+.flyer-updated-text {
+  font-size: 11px;
+  font-weight: 500;
+  color: #9CA3AF;
+  letter-spacing: 0.1px;
+}
+.flyer-date-badge {
+  text-align: right;
