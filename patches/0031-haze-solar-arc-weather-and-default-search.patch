+
+  function getBrandKey(url: string, title: string): string | null {
+    const host = getDomain(url).toLowerCase();
+    const t = (title || '').toLowerCase();
+    if (host.includes('facebook.com') || host.includes('fb.com') || t.includes('facebook')) return 'facebook';
+    if (host.includes('youtube.com') || host.includes('youtu.be') || t.includes('youtube')) return 'youtube';
+    if (host.includes('github.com') || t.includes('github')) return 'github';
+    if (host.includes('google.com') || t.includes('google')) return 'google';
+    if (host.includes('wikipedia.org') || t.includes('wikipedia')) return 'wikipedia';
+    if (host.includes('reddit.com') || t.includes('reddit')) return 'reddit';
+    if (host.includes('twitter.com') || host.includes('x.com') || t === 'x' || t.includes('twitter')) return 'x';
+    if (host.includes('chatgpt.com') || host.includes('openai.com') || t.includes('chatgpt') || t.includes('openai')) return 'chatgpt';
+    if (host.includes('linkedin.com') || t.includes('linkedin')) return 'linkedin';
+    if (host.includes('amazon.') || t.includes('amazon')) return 'amazon';
+    if (host.includes('duckduckgo.com') || t.includes('duckduckgo')) return 'duckduckgo';
+    return null;
+  }
+
+  function getFaviconUrl(pageUrl: string): string {
+    const domain = getDomain(pageUrl);
+    return 'chrome://image?url=' + encodeURIComponent('https://www.google.com/s2/favicons?domain=' + domain + '&sz=64');
+  }
+
+  function getFallbackFaviconUrl(pageUrl: string): string {
+    try {
+      const parsed = new URL(pageUrl);
+      return 'chrome://image?url=' + encodeURIComponent(parsed.origin + '/favicon.ico');
+    } catch (_e) {
+      return 'chrome://favicon2/?size=32&scaleFactor=1x&pageUrl=' + encodeURIComponent(pageUrl);
+    }
+  }
+
+
+  function renderPins(): void {
+    if (!pinsContainer || !pinsRowSelect) return;
+    const rowSetting = parseInt(pinsRowSelect.value, 10);
+    if (rowSetting === 0) {
+      pinsContainer.classList.add('hidden');
+      return;
+    }
+    pinsContainer.classList.remove('hidden');
+
+    const shortcuts = getShortcuts();
+    const pinned = shortcuts.filter(s => s.pinned);
+    const unpinned = shortcuts.filter(s => !s.pinned).sort((a, b) => (b.visits || 0) - (a.visits || 0));
+    const sorted = [...pinned, ...unpinned];
+
+    const maxCapacity = rowSetting * 6;
+    const maxSites = maxCapacity - 1;
+    const displaySites = sorted.slice(0, maxSites);
+
+    while (pinsContainer.firstChild) {
+      pinsContainer.removeChild(pinsContainer.firstChild);
+    }
+
+    displaySites.forEach(site => {
+      const tile = document.createElement('a');
+      tile.className = 'pin-tile';
+      tile.href = site.url;
+      tile.title = `${site.title} (${site.url})`;
+
+      tile.addEventListener('click', (e: MouseEvent) => {
+        const target = e.target as HTMLElement;
+        if (target && target.closest('.tile-btn')) return;
+        site.visits = (site.visits || 0) + 1;
+        saveShortcuts(shortcuts);
+      });
+
+      // Pin button
+      const pinBtn = document.createElement('button');
+      pinBtn.className = `tile-btn tile-pin-btn${site.pinned ? ' is-pinned' : ''}`;
+      pinBtn.title = site.pinned ? 'Unpin shortcut' : 'Pin shortcut';
+      pinBtn.appendChild(createSvgIcon('pin', site.pinned));
+      pinBtn.addEventListener('click', (e: MouseEvent) => {
+        e.preventDefault();
+        e.stopPropagation();
+        site.pinned = !site.pinned;
+        saveShortcuts(shortcuts);
+        renderPins();
+      });
+      tile.appendChild(pinBtn);
+
+      // Remove button
+      const removeBtn = document.createElement('button');
+      removeBtn.className = 'tile-btn tile-remove-btn';
+      removeBtn.title = 'Remove shortcut';
+      removeBtn.appendChild(createSvgIcon('close', false));
+      removeBtn.addEventListener('click', (e: MouseEvent) => {
+        e.preventDefault();
+        e.stopPropagation();
+        const updated = shortcuts.filter(s => s.id !== site.id);
+        saveShortcuts(updated);
+        renderPins();
+      });
+      tile.appendChild(removeBtn);
+
+      // Favicon Box
+      const iconBox = document.createElement('div');
+      iconBox.className = 'tile-icon-box';
+
+      const img = document.createElement('img');
+      img.className = 'tile-favicon-img';
+      img.src = getFaviconUrl(site.url);
+      img.alt = site.title;
+
+      let fallbackAttempt = 0;
+      img.onerror = () => {
+        if (fallbackAttempt === 0) {
+          fallbackAttempt = 1;
+          img.src = getFallbackFaviconUrl(site.url);
+          return;
+        }
+        if (fallbackAttempt === 1) {
+          fallbackAttempt = 2;
+          img.src = 'chrome://favicon2/?size=32&scaleFactor=1x&pageUrl=' + encodeURIComponent(site.url);
+          return;
+        }
+        if (img.parentElement) {
+          img.parentElement.removeChild(img);
+          const brandKey = getBrandKey(site.url, site.title);
+          const brandSvg = brandKey ? createBrandLogo(brandKey) : null;
+          if (brandSvg) {
+            iconBox.appendChild(brandSvg);
+          } else {
+            const letter = document.createElement('span');
+            letter.className = 'tile-letter-avatar';
+            letter.textContent = (site.title || 'W').charAt(0).toUpperCase();
+            iconBox.appendChild(letter);
+          }
+        }
+      };
+      iconBox.appendChild(img);
+      tile.appendChild(iconBox);
+
+      // Title
+      const titleSpan = document.createElement('span');
+      titleSpan.className = 'tile-title';
+      titleSpan.textContent = site.title;
+      tile.appendChild(titleSpan);
+
+      pinsContainer.appendChild(tile);
+    });
+
+    // Plus "+" button at the end
+    const addTile = document.createElement('div');
+    addTile.className = 'pin-tile add-pin-tile';
+    addTile.title = 'Add shortcut';
+
+    const addIconBox = document.createElement('div');
+    addIconBox.className = 'tile-icon-box';
+    addIconBox.style.background = 'transparent';
+    addIconBox.style.boxShadow = 'none';
+    addIconBox.appendChild(createSvgIcon('plus', false));
+    addTile.appendChild(addIconBox);
+
+    const addTitle = document.createElement('span');
+    addTitle.className = 'tile-title';
+    addTitle.textContent = 'Add';
+    addTile.appendChild(addTitle);
+
+    addTile.addEventListener('click', openModal);
+    pinsContainer.appendChild(addTile);
+  }
+
+  // Pins Row Select setting
+  if (pinsRowSelect) {
+    const savedRowSetting = localStorage.getItem('haze_pins_rows');
+    if (savedRowSetting !== null) {
+      pinsRowSelect.value = savedRowSetting;
+    }
+    pinsRowSelect.addEventListener('change', () => {
+      try {
+        localStorage.setItem('haze_pins_rows', pinsRowSelect.value);
+      } catch (_e) {}
+      renderPins();
+    });
+  }
+
+  renderPins();
+
+  // 5. Add Pin Modal Dialog
+  const addPinModal = document.getElementById('addPinModal');
+  const pinTitleInput = document.getElementById('pinTitleInput') as HTMLInputElement | null;
+  const pinUrlInput = document.getElementById('pinUrlInput') as HTMLInputElement | null;
+  const cancelPinBtn = document.getElementById('cancelPinBtn');
+  const savePinBtn = document.getElementById('savePinBtn');
+
+  function openModal(): void {
+    if (!addPinModal || !pinTitleInput || !pinUrlInput) return;
+    pinTitleInput.value = '';
+    pinUrlInput.value = '';
+    addPinModal.classList.add('open');
+    setTimeout(() => pinTitleInput?.focus(), 50);
+  }
+  function closeModal(): void {
+    if (addPinModal) addPinModal.classList.remove('open');
+  }
+
+  if (cancelPinBtn) cancelPinBtn.addEventListener('click', closeModal);
+  if (addPinModal) {
+    addPinModal.addEventListener('click', (e: MouseEvent) => {
+      if (e.target === addPinModal) closeModal();
+    });
+  }
+
+  if (savePinBtn) {
+    savePinBtn.addEventListener('click', () => {
+      if (!pinUrlInput) return;
+      let url = pinUrlInput.value.trim();
+      if (!url) return;
+      if (!/^https?:\/\//i.test(url)) {
+        url = 'https://' + url;
+      }
+      let title = pinTitleInput ? pinTitleInput.value.trim() : '';
+      if (!title) {
+        title = getDomain(url).replace(/^www\./, '');
+      }
+
+      const shortcuts = getShortcuts();
+      const newShortcut: ShortcutItem = {
+        id: 'custom_' + Date.now(),
+        title: title,
+        url: url,
+        pinned: true,
+        visits: 5
+      };
+      shortcuts.unshift(newShortcut);
+      saveShortcuts(shortcuts);
+      closeModal();
+      renderPins();
+    });
+  }
+
+  if (pinUrlInput) {
+    pinUrlInput.addEventListener('keydown', (e: KeyboardEvent) => {
+      if (e.key === 'Enter' && savePinBtn) savePinBtn.click();
+    });
+  }
+  if (pinTitleInput) {
+    pinTitleInput.addEventListener('keydown', (e: KeyboardEvent) => {
+      if (e.key === 'Enter' && pinUrlInput) pinUrlInput.focus();
+    });
+  }
+}
+
+if (document.readyState === 'loading') {
+  document.addEventListener('DOMContentLoaded', initHazeHomescreen);
+} else {
+  initHazeHomescreen();
+}
