+          iconType = 'night';
+          condition = (hour >= 18 && hour < 21) ? 'Clear Evening' : 'Clear Night';
+        }
+      } else if (hour >= 6 && hour < 12) {
+        currentTemp = baseTemp - 2;
+        if (theme === 'sunny') condition = 'Sunny Morning';
+      } else if (hour >= 12 && hour < 16) {
+        currentTemp = baseTemp;
+        if (theme === 'sunny') condition = 'Sunny Afternoon';
+      } else {
+        currentTemp = baseTemp - 1;
+        if (theme === 'sunny') condition = 'Sunny Afternoon';
+      }
