+        const mLeft = Math.floor((secondsToSunset % 3600) / 60);
+        timeTitle = `${hLeft}h ${mLeft}m left until sunset (Sunset at 6:00 PM)`;
+      } else {
+        if (currentDecimalHour >= 18.0) {
