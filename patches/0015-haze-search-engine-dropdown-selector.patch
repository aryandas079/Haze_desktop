+ui::ImageModel MakeImageModelFromPngData(base::span<const uint8_t> png_1x,
+                                         base::span<const uint8_t> png_2x) {
+  SkBitmap bm1x = gfx::PNGCodec::Decode(png_1x);
+  SkBitmap bm2x = gfx::PNGCodec::Decode(png_2x);
+  gfx::ImageSkia image_skia;
