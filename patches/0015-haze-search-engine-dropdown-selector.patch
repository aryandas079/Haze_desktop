+          chrome::ExecuteCommand(browser_, IDC_SHOW_BOOKMARK_MANAGER);
+        }
+        break;
+      case kActionTabs:
+        if (browser_) {
+          chrome::ExecuteCommand(browser_, IDC_TAB_SEARCH);
+        }
+        break;
+      case kActionHistory:
+        if (browser_) {
+          chrome::ExecuteCommand(browser_, IDC_SHOW_HISTORY);
+        }
+        break;
+      case kActionActions:
+        if (bar_->GetOmniboxView()) {
+          bar_->GetOmniboxView()->SetFocus(/*is_user_initiated=*/true);
+          bar_->GetOmniboxView()->SetUserText(u"@");
+        }
+        break;
+      case kActionSettings:
+        if (browser_) {
+          chrome::ExecuteCommand(browser_, IDC_OPTIONS);
+        }
+        break;
+    }
+  }
+
+  void MenuClosed(ui::SimpleMenuModel* source) override {
+    if (bar_->location_icon_view()) {
+      bar_->location_icon_view()->SetMenuShowing(false);
+    }
+  }
+
+ private:
+  void SetSearchEngine(const std::u16string& name,
+                       const std::u16string& keyword,
+                       const std::string& domain,
+                       const std::string& search_url,
+                       const std::string& favicon_url) {
+    TemplateURLService* service =
+        TemplateURLServiceFactory::GetForProfile(profile_);
+    if (service) {
+      if (!service->loaded()) {
+        service->Load();
+      }
+      TemplateURL* target_turl = nullptr;
+      for (TemplateURL* turl : service->GetTemplateURLs()) {
+        if (turl->url().find(domain) != std::string::npos) {
+          target_turl = turl;
+          break;
+        }
+      }
+      if (!target_turl) {
+        TemplateURLData data;
+        data.SetShortName(name);
+        data.SetKeyword(keyword);
+        data.SetURL(search_url);
+        data.favicon_url = GURL(favicon_url);
+        target_turl = service->Add(std::make_unique<TemplateURL>(data));
+      }
+      if (target_turl) {
+        service->SetUserSelectedDefaultSearchProvider(target_turl);
+      }
+    }
+
+    if (bar_->location_icon_view()) {
+      bar_->location_icon_view()->Update(/*suppress_animations=*/true);
+    }
+    bar_->SchedulePaint();
+
+    auto* edit_model = bar_->GetOmniboxController()
+                           ? bar_->GetOmniboxController()->edit_model()
+                           : nullptr;
+    auto* omnibox_view = bar_->GetOmniboxView();
+    std::u16string text =
+        omnibox_view ? omnibox_view->GetText() : std::u16string();
+    if (!text.empty() && edit_model && edit_model->user_input_in_progress()) {
+      std::string escaped =
+          base::EscapeQueryParamValue(base::UTF16ToUTF8(text), true);
+      std::string nav_url = search_url;
+      base::ReplaceFirstSubstringAfterOffset(&nav_url, 0, "{searchTerms}",
+                                             escaped);
+      if (bar_->GetWebContents()) {
+        bar_->GetWebContents()->GetController().LoadURL(
+            GURL(nav_url), content::Referrer(),
+            ui::PAGE_TRANSITION_GENERATED, std::string());
+      }
+    } else if (omnibox_view) {
+      omnibox_view->SetFocus(/*is_user_initiated=*/true);
+    }
+  }
+
+  raw_ptr<LocationBarView> bar_;
+  raw_ptr<BrowserWindowInterface> browser_;
+  raw_ptr<Profile> profile_;
+};
