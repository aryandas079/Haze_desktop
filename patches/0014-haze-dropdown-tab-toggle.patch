+void BrowserView::SetHazeTabMode(HazeTabMode mode) {
+  if (haze_tab_mode_ == mode) {
+    return;
+  }
+  haze_tab_mode_ = mode;
+
+  auto* const vts_controller =
+      tabs::VerticalTabStripStateController::From(browser_);
+
+  if (haze_tab_mode_ == HazeTabMode::kVertical) {
+    if (vts_controller && !vts_controller->ShouldDisplayVerticalTabs()) {
+      vts_controller->SetVerticalTabsEnabled(true);
+    }
+  } else {
+    if (vts_controller && vts_controller->ShouldDisplayVerticalTabs()) {
+      vts_controller->SetVerticalTabsEnabled(false);
+    }
+    if (haze_tab_mode_ == HazeTabMode::kHorizontal) {
+      if (horizontal_tab_strip_region_view_) {
+        horizontal_tab_strip_region_view_->InitializeTabStrip();
+      }
+    }
+  }
+
+  if (GetFrameView()) {
+    GetFrameView()->OnTabStripStateChanged();
+  }
+  UpdateTabSearchBubbleHost();
+  InvalidateLayout();
+  SchedulePaint();
+}
+
+void BrowserView::CycleHazeTabMode() {
+  switch (haze_tab_mode_) {
+    case HazeTabMode::kNone:
+      SetHazeTabMode(HazeTabMode::kHorizontal);
+      break;
+    case HazeTabMode::kHorizontal:
+      SetHazeTabMode(HazeTabMode::kVertical);
+      break;
+    case HazeTabMode::kVertical:
+      SetHazeTabMode(HazeTabMode::kNone);
+      break;
+  }
+}
