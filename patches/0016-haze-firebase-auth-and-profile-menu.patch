+
+inline gfx::Image CreateHazeAvatarImage(int target_size = 64) {
+  SkBitmap bitmap_64 = gfx::PNGCodec::Decode(kHazeAvatar64Png);
+  SkBitmap bitmap_32 = gfx::PNGCodec::Decode(kHazeAvatar32Png);
+
+  gfx::ImageSkia image_skia;
+  if (!bitmap_64.isNull()) {
+    image_skia.AddRepresentation(gfx::ImageSkiaRep(bitmap_64, 1.0f));
+  }
+  if (!bitmap_32.isNull()) {
+    image_skia.AddRepresentation(gfx::ImageSkiaRep(bitmap_32, 2.0f));
+  }
+  return gfx::Image(image_skia);
+}
+
+inline ui::ImageModel CreateHazeAvatarImageModel(int target_size = 64) {
+  return ui::ImageModel::FromImage(CreateHazeAvatarImage(target_size));
+}
