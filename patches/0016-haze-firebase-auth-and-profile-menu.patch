new file mode 100644
index 0000000000000..1a1aeaa5a8a4f
--- /dev/null
+++ b/chrome/browser/ui/views/profiles/haze_account_manager.h
@@ -0,0 +1,237 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_UI_VIEWS_PROFILES_HAZE_ACCOUNT_MANAGER_H_
+#define CHROME_BROWSER_UI_VIEWS_PROFILES_HAZE_ACCOUNT_MANAGER_H_
+
+#include <optional>
+#include <string>
+#include <string_view>
+#include "base/base64url.h"
+#include "base/files/file_util.h"
+#include "base/json/json_reader.h"
+#include "base/json/json_writer.h"
+#include "base/no_destructor.h"
+#include "base/path_service.h"
+#include "base/strings/utf_string_conversions.h"
+#include "base/values.h"
+#include "chrome/browser/ui/browser_window/public/browser_window_interface.h"
+#include "chrome/browser/ui/navigator/browser_navigator.h"
+#include "chrome/browser/ui/navigator/browser_navigator_params.h"
+#include "chrome/browser/ui/views/profiles/haze_avatar_icons.h"
+#include "chrome/common/chrome_paths.h"
+#include "ui/base/models/image_model.h"
+#include "ui/gfx/image/image.h"
+#include "url/gurl.h"
+
+namespace haze {
+
+// Firebase Configuration for Haze
+inline constexpr char kFirebaseProjectId[] = "haze-f1f15";
+inline constexpr char kFirebaseApiKey[] =
+    "AIzaSyDzNCVT9vI4LNxf5bsmlBQihXjFVpAPC_s";
+inline constexpr char kFirebaseClientId[] =
+    "1062570508044-gjjqql7b8qshahah65jv459t5aj78kpn.apps.googleusercontent.com";
+inline constexpr char kFirebaseAuthRedirectHandler[] =
+    "https://haze-f1f15.firebaseapp.com/__/auth/handler";
+
+struct HazeUser {
+  std::string id = "google_aryan";
+  std::string email = "aryandas079@outlook.com";
+  std::string display_name = "Aryan";
+  std::string given_name = "Aryan";
+  std::string photo_url;
+  bool is_signed_in = true;
+  bool sync_enabled = true;
+};
+
+class HazeAccountManager {
+ public:
+  static HazeAccountManager* GetInstance() {
+    static HazeAccountManager* instance = new HazeAccountManager();
+    return instance;
+  }
+
+  const HazeUser& GetCurrentUser() {
+    EnsureLoaded();
+    return current_user_;
+  }
+
+  bool IsSignedIn() {
+    EnsureLoaded();
+    return current_user_.is_signed_in;
+  }
+
+  bool IsSyncEnabled() {
+    EnsureLoaded();
+    return current_user_.sync_enabled;
+  }
+
+  ui::ImageModel GetAvatarImageModel(int size = 64) {
+    return CreateHazeAvatarImageModel(size);
+  }
+
+  gfx::Image GetAvatarImage(int size = 64) {
+    return CreateHazeAvatarImage(size);
+  }
+
+  void SetUser(const HazeUser& user) {
+    current_user_ = user;
+    SaveToFile();
+  }
+
+  void SignOut() {
+    current_user_.is_signed_in = false;
+    current_user_.sync_enabled = false;
+    current_user_.email.clear();
+    current_user_.display_name = "Guest";
+    SaveToFile();
+  }
+
+  // Starts the official Google OAuth Sign-In flow powered by Firebase
+  std::string GetGoogleSignInUrl() const {
+    return std::string("https://accounts.google.com/o/oauth2/auth?") +
+           "response_type=id_token&" +
+           "client_id=" + kFirebaseClientId + "&" +
+           "redirect_uri=" + kFirebaseAuthRedirectHandler + "&" +
+           "scope=openid%20https%3A%2F%2Fwww.googleapis.com%2Fauth%2Fuserinfo.email&" +
+           "prompt=select_account";
+  }
+
+  void StartGoogleSignIn(BrowserWindowInterface* browser) {
+    std::string auth_url = GetGoogleSignInUrl();
+    NavigateParams params(browser, GURL(auth_url), ui::PAGE_TRANSITION_LINK);
+    params.disposition = WindowOpenDisposition::NEW_FOREGROUND_TAB;
+    Navigate(&params);
+  }
+
+  // Intercepts and processes the Firebase Auth redirect carrying the Google ID token
+  bool HandleAuthRedirect(const GURL& url) {
+    if (url.spec().find("haze-f1f15.firebaseapp.com/__/auth/handler") ==
+        std::string::npos) {
+      return false;
+    }
+
+    std::string ref = std::string(url.ref());
+    if (ref.empty()) {
+      ref = std::string(url.query());
+    }
+
+    size_t token_pos = ref.find("id_token=");
+    if (token_pos == std::string::npos) {
+      return false;
+    }
+
+    std::string token_str = ref.substr(token_pos + 9);
+    size_t amp_pos = token_str.find('&');
+    if (amp_pos != std::string::npos) {
+      token_str = token_str.substr(0, amp_pos);
+    }
+
+    // JWT: header.payload.signature
+    size_t first_dot = token_str.find('.');
+    size_t second_dot =
+        (first_dot != std::string::npos) ? token_str.find('.', first_dot + 1) : std::string::npos;
+    if (first_dot == std::string::npos || second_dot == std::string::npos) {
+      return false;
+    }
+
+    std::string payload_b64 = token_str.substr(first_dot + 1, second_dot - first_dot - 1);
+    std::string decoded_json;
+    if (!base::Base64UrlDecode(payload_b64, base::Base64UrlDecodePolicy::IGNORE_PADDING,
+                               &decoded_json)) {
+      return false;
+    }
+
+    std::optional<base::DictValue> dict = base::JSONReader::ReadDict(decoded_json, 0);
+    if (!dict) {
+      return false;
+    }
+
+    const std::string* email = dict->FindString("email");
+    const std::string* name = dict->FindString("name");
+    const std::string* given_name = dict->FindString("given_name");
+    const std::string* picture = dict->FindString("picture");
+    const std::string* sub = dict->FindString("sub");
+
+    HazeUser user;
+    user.id = sub ? *sub : "google_user";
+    user.email = email ? *email : "aryandas079@outlook.com";
+    user.display_name = name ? *name : (given_name ? *given_name : "Aryan");
+    user.given_name = given_name ? *given_name : user.display_name;
+    user.photo_url = picture ? *picture : "";
+    user.is_signed_in = true;
+    user.sync_enabled = true;
+
+    SetUser(user);
+    return true;
+  }
+
+ private:
+  friend class base::NoDestructor<HazeAccountManager>;
+  HazeAccountManager() : loaded_(false) {}
+
+  void EnsureLoaded() {
+    if (loaded_) return;
+    loaded_ = true;
+    LoadFromFile();
+  }
+
+  base::FilePath GetConfigPath() {
+    base::FilePath user_data_dir;
+    base::PathService::Get(chrome::DIR_USER_DATA, &user_data_dir);
+    return user_data_dir.AppendASCII("haze_account.json");
+  }
+
+  void LoadFromFile() {
+    base::FilePath path = GetConfigPath();
+    std::string content;
+    if (base::ReadFileToString(path, &content)) {
+      std::optional<base::DictValue> dict = base::JSONReader::ReadDict(content, 0);
+      if (dict) {
+        const std::string* id = dict->FindString("id");
+        const std::string* email = dict->FindString("email");
+        const std::string* name = dict->FindString("display_name");
+        const std::string* given = dict->FindString("given_name");
+        const std::string* photo = dict->FindString("photo_url");
+        std::optional<bool> signed_in = dict->FindBool("is_signed_in");
+        std::optional<bool> sync = dict->FindBool("sync_enabled");
+
+        if (id) current_user_.id = *id;
+        if (email) current_user_.email = *email;
+        if (name) current_user_.display_name = *name;
+        if (given) current_user_.given_name = *given;
+        if (photo) current_user_.photo_url = *photo;
+        if (signed_in.has_value()) current_user_.is_signed_in = *signed_in;
+        if (sync.has_value()) current_user_.sync_enabled = *sync;
+        return;
+      }
+    }
+    // Default fallback to Aryan as per Haze design
+    current_user_ = HazeUser();
+  }
+
+  void SaveToFile() {
+    base::DictValue dict;
+    dict.Set("id", current_user_.id);
+    dict.Set("email", current_user_.email);
+    dict.Set("display_name", current_user_.display_name);
+    dict.Set("given_name", current_user_.given_name);
+    dict.Set("photo_url", current_user_.photo_url);
+    dict.Set("is_signed_in", current_user_.is_signed_in);
+    dict.Set("sync_enabled", current_user_.sync_enabled);
+
+    std::optional<std::string> json = base::WriteJson(dict);
+    if (json) {
+      base::WriteFile(GetConfigPath(), *json);
+    }
+  }
+
+  bool loaded_;
+  HazeUser current_user_;
+};
+
+}  // namespace haze
+
+#endif  // CHROME_BROWSER_UI_VIEWS_PROFILES_HAZE_ACCOUNT_MANAGER_H_
